<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:entry title="Description" field="description">
        <f:textbox />
    </f:entry>
    <f:entry title="Server" field="pcServerName">
        <f:textbox />
    </f:entry>
    <f:entry title="Use HTTPS Protocol" field="HTTPSProtocol">
        <f:checkbox />
    </f:entry>
    <f:entry title="Use Token For Authentication" field="authenticateWithToken">
        <f:checkbox />
    </f:entry>
    <f:entry title="Credentials" field="credentialsId">
        <c:select expressionAllowed="true" />
    </f:entry>
    <f:entry title="Domain" field="almDomain">
        <f:textbox />
    </f:entry>
    <f:entry title="Project" field="almProject">
        <f:textbox />
    </f:entry>
    <f:entry title="Jenkins URL" field="serverAndPort">
        <f:textbox default="${app.rootUrl}" />
    </f:entry>
    <f:entry title="Test ID" field="testId">
        <f:textbox />
    </f:entry>
    <f:entry title="Test Instance Selection" field="autoTestInstanceID">
        <select name="_.autoTestInstanceID">
            <f:option value="AUTO" selected="${instance == null || instance.autoTestInstanceID == 'AUTO'}">Automatic</f:option>
            <f:option value="MANUAL" selected="${instance.autoTestInstanceID == 'MANUAL'}">Manual</f:option>
        </select>
    </f:entry>
    <f:entry title="Test Instance ID (manual selection)" field="testInstanceId">
        <f:textbox />
    </f:entry>
    <f:entry title="Local Proxy" field="proxyOutURL">
        <f:textbox />
    </f:entry>
    <f:entry title="Proxy Credentials" field="credentialsProxyId">
        <c:select expressionAllowed="true" />
    </f:entry>
    <f:entry title="Post Run Action" field="postRunAction">
        <select name="_.postRunAction">
            <j:forEach var="action" items="${descriptor.postRunActions}">
                <f:option value="${action}" selected="${action == instance.postRunAction}">${action.value}</f:option>
            </j:forEach>
        </select>
    </f:entry>
    <f:entry title="Trending (requires Collate and Analyze)" field="addRunToTrendReport">
        <select name="_.addRunToTrendReport">
            <f:option value="NO_TREND" selected="${instance == null || instance.addRunToTrendReport == 'NO_TREND'}">Do Not Trend</f:option>
            <f:option value="ASSOCIATED" selected="${instance.addRunToTrendReport == 'ASSOCIATED'}">Use trend report associated with the test</f:option>
            <f:option value="USE_ID" selected="${instance.addRunToTrendReport == 'USE_ID'}">Add run to trend report with ID</f:option>
        </select>
    </f:entry>
    <f:entry title="Trend Report ID (when adding by ID)" field="trendReportId">
        <f:textbox />
    </f:entry>
    <f:entry title="Timeslot Duration Hours" field="timeslotDurationHours">
        <f:textbox default="0" />
    </f:entry>
    <f:entry title="Timeslot Duration Minutes (minimum total: 30 minutes)" field="timeslotDurationMinutes">
        <f:textbox default="30" />
    </f:entry>
    <f:entry title="Use VUDs" field="vudsMode">
        <f:checkbox />
    </f:entry>
    <f:entry title="Set step status according to SLA" field="statusBySLA">
        <f:checkbox />
    </f:entry>
    <f:entry title="On Timeslot Creation Failure" field="retry">
        <select name="_.retry">
            <f:option value="NO_RETRY" selected="${instance == null || instance.retry == 'NO_RETRY'}">Do Not Repeat</f:option>
            <f:option value="RETRY" selected="${instance.retry == 'RETRY'}">Repeat</f:option>
        </select>
    </f:entry>
    <f:entry title="Delay between attempts (minutes)" field="retryDelay">
        <f:textbox />
    </f:entry>
    <f:entry title="Number of attempts" field="retryOccurrences">
        <f:textbox />
    </f:entry>
</j:jelly>
